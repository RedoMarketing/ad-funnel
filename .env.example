NEXT_PUBLIC_SUPABASE_URL=https://jjezreqahluvohgxpoma.supabase.co

# Secret (service_role) key. SERVER ONLY — never prefix this with NEXT_PUBLIC_.
# The funnel_* tables have RLS on with no policies, so this key is the only way
# to read or write them. Supabase dashboard → Project Settings → API keys.
SUPABASE_SECRET_KEY=

